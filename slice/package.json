{
  "name": "hopin-slice",
  "private": true,
  "version": "0.1.0",
  "description": "Thin running slice of the Hopin API (plan step S123): ride request, matching, outbox.",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand src/domain",
    "load": "tsx load/run.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/platform-socket.io": "^11.2.5",
    "@nestjs/websockets": "^11.2.5",
    "@socket.io/redis-adapter": "^8.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "jest": "^30.5.2",
    "socket.io-client": "^4.8.3",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
